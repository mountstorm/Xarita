{
  "rewrites": [
    { "source": "/tiles/ohm/:z/:x/:y.pbf", "destination": "/api/ohm?z=:z&x=:x&y=:y" }
  ],
  "headers": [
    {
      "source": "/(data|vendor)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(app|i18n|sources|tours)\\.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/styles\\.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
