{
  "installCommand": "echo 'static site: nothing to install'",
  "buildCommand": "",
  "rewrites": [
    {
      "source": "/tiles/ohm/:z/:x/:y.pbf",
      "destination": "/api/ohm?z=:z&x=:x&y=:y"
    }
  ],
  "headers": [
    {
      "source": "/(data|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/styles\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
